// ============================================================
//  SW중심대학사업 관리 시스템 — ERD (DBML)
//  붙여넣기: https://dbdiagram.io 좌측 코드창 전체 교체
//  수정: 타입과 [...] 사이 띄어쓰기 오류 완벽 수정
// ============================================================


// ─────────────────────────────────────
//  01 공통·계정
// ─────────────────────────────────────

Table USER [note: '로그인 계정 (학생·관리자 공통)'] {
  user_id             int          [pk, increment, note: '사용자ID']
  login_id            varchar(30)  [unique, not null, note: '로그인ID (중복 불가)']
  password_hash       varchar(255) [not null, note: '비밀번호 해시']
  user_name           varchar(50)  [not null, note: '성명']
  user_type           varchar(20)  [not null, note: '학생/마스터관리자/일반관리자']
  is_active           varchar(1)   [default: 'Y', note: '사용여부 Y/N']
  password_changed_at timestamp    [note: '비밀번호변경일시']
  created_at          timestamp    [not null, note: '등록일시']
  last_login_at       timestamp    [note: '최종로그인일시']
}

Table ROLE [note: '역할 종류'] {
  role_id     int         [pk, increment, note: '역할ID']
  role_code   varchar(20) [unique, not null, note: '역할코드 (중복 불가)']
  role_name   varchar(50) [not null, note: '역할명']
  description varchar(200) [note: '설명']
  is_use      varchar(1)  [default: 'Y', note: '사용여부 Y/N']
}

Table USER_ROLE [note: '사용자↔역할 매핑 (N:M 해소)'] {
  user_role_id int       [pk, increment, note: '매핑ID']
  user_id      int       [not null, ref: > USER.user_id, note: '사용자ID']
  role_id      int       [not null, ref: > ROLE.role_id, note: '역할ID']
  granted_at   timestamp [not null, note: '부여일시']
  granted_by   int       [ref: > USER.user_id, note: '부여자']

  indexes {
    (user_id, role_id) [unique, name: 'uq_user_role']
  }
}

Table COMMON_CODE_GROUP [note: '공통코드 상위 분류'] {
  group_code  varchar(20)  [pk, note: '코드그룹코드']
  group_name  varchar(50)  [not null, note: '코드그룹명']
  description varchar(200) [note: '설명']
  is_use      varchar(1)   [default: 'Y', note: '사용여부 Y/N']
}

Table COMMON_CODE [note: '허용 코드값 목록 (복합PK)'] {
  group_code varchar(20) [pk, ref: > COMMON_CODE_GROUP.group_code, note: '코드그룹코드']
  code       varchar(20) [pk, note: '코드값']
  code_name  varchar(50) [not null, note: '코드명']
  sort_order int         [note: '정렬순서']
  is_use     varchar(1)  [default: 'Y', note: '사용여부 Y/N']
}

Table CHANGE_LOG [note: '공통 변경 감사 로그'] {
  log_id        bigint       [pk, increment, note: '로그ID']
  target_entity varchar(30)  [not null, note: '대상 테이블명']
  target_id     varchar(50)  [not null, note: '대상 PK값']
  action_type   varchar(20)  [not null, note: 'INSERT / UPDATE / DELETE']
  before_data   varchar(2000) [note: '변경전 데이터 (JSON)']
  after_data    varchar(2000) [note: '변경후 데이터 (JSON)']
  created_by    int          [ref: > USER.user_id, note: '처리자']
  created_at    timestamp    [not null, note: '처리일시']
  reason        varchar(500) [note: '사유']
}


// ─────────────────────────────────────
//  02 학생 관리
// ─────────────────────────────────────

Table DEPARTMENT [note: '학과 기준정보'] {
  dept_id   int         [pk, increment, note: '학과ID']
  dept_code varchar(20) [unique, not null, note: '학과코드']
  dept_name varchar(50) [not null, note: '학과명']
  college   varchar(50) [note: '소속대학']
  campus    varchar(30) [note: '캠퍼스']
  is_use    varchar(1)  [default: 'Y', note: '사용여부 Y/N']
}

Table STUDENT [note: '학생 현재 기본정보'] {
  student_id      int          [pk, increment, note: '학생ID']
  user_id         int          [unique, not null, ref: > USER.user_id, note: '사용자ID (1:1)']
  student_no      varchar(20)  [unique, not null, note: '학번']
  dept_id         int          [not null, ref: > DEPARTMENT.dept_id, note: '학과ID']
  track_code      varchar(20)  [note: '등록계열 (공학/자연)']
  grade           int          [note: '학년 1~4']
  academic_status varchar(20)  [note: '학적상태 (재학/휴학/졸업 등)']
  admission_type  varchar(20)  [note: '입학구분 (신입/편입)']
  admission_date  date         [note: '입학일자']
  phone           varchar(20)  [note: '휴대폰번호']
  sms_agree_yn    varchar(1)   [default: 'Y', note: 'SMS수신여부 Y/N']
  email           varchar(100) [note: '이메일']
  created_at      timestamp    [not null, note: '등록일시']
  updated_at      timestamp    [note: '최종수정일시']
}

Table ENROLLMENT_HISTORY [note: '학적 변동 이력'] {
  enroll_hist_id bigint      [pk, increment, note: '학적변동ID']
  student_id     int         [not null, ref: > STUDENT.student_id, note: '학생ID']
  change_type    varchar(20) [not null, note: '변동구분 (휴학/복학/졸업 등)']
  before_status  varchar(20) [note: '변동전 학적상태']
  after_status   varchar(20) [note: '변동후 학적상태']
  change_date    date        [not null, note: '학적변동일자']
  created_by     int         [ref: > USER.user_id, note: '등록자']
  created_at     timestamp   [not null, note: '등록일시']
}

Table STUDENT_INFO_REQUEST [note: '학생 인적사항 수정 요청'] {
  request_id      bigint      [pk, increment, note: '요청ID']
  student_id      int         [not null, ref: > STUDENT.student_id, note: '학생ID']
  request_field   varchar(30) [not null, note: '요청항목 (컬럼명)']
  before_val      varchar(200) [note: '기존값']
  after_val       varchar(200) [not null, note: '변경값']
  request_dt      timestamp   [not null, note: '요청일시']
  status          varchar(20) [default: '대기', note: '처리상태 (대기/승인/반려)']
  approver_id     int         [ref: > USER.user_id, note: '승인자']
  process_dt      timestamp   [note: '처리일시']
  process_comment varchar(500) [note: '처리의견']
}


// ─────────────────────────────────────
//  03 TOPCIT
// ─────────────────────────────────────

Table TOPCIT_ROUND [note: 'TOPCIT 시험 회차'] {
  round_id    int         [pk, increment, note: '회차ID']
  round_name  varchar(50) [not null, note: '회차명']
  exam_date   date        [not null, note: '시험일자']
  max_score   int         [default: 1000, note: '최고점 (고정 1000)']
  description varchar(200) [note: '설명']
  status      varchar(20) [note: '상태']
}

Table TOPCIT_SCORE [note: '학생별 회차 점수 (학생+회차 UNIQUE)'] {
  score_id    bigint      [pk, increment, note: '점수ID']
  student_id  int         [not null, ref: > STUDENT.student_id, note: '학생ID']
  round_id    int         [not null, ref: > TOPCIT_ROUND.round_id, note: '회차ID']
  total_score int         [not null, note: '총점 0~1000']
  remark      varchar(500) [note: '비고']
  created_by  int         [ref: > USER.user_id, note: '등록자']
  created_at  timestamp   [not null, note: '등록일시']
  updated_at  timestamp   [note: '수정일시']

  indexes {
    (student_id, round_id) [unique, name: 'uq_topcit_score']
  }
}


// ─────────────────────────────────────
//  04 마일리지
// ─────────────────────────────────────

Table PROGRAM [note: '활동 프로그램 (마일리지·만족도 공유)'] {
  program_id    int          [pk, increment, note: '프로그램ID']
  prog_category varchar(20)  [not null, note: '프로그램구분']
  prog_name     varchar(200) [not null, note: '프로그램명']
  prog_date     date         [note: '프로그램일자']
  organizer     varchar(100) [note: '주최·주관']
  status        varchar(20)  [default: '활성', note: '상태']
  created_by    int          [ref: > USER.user_id, note: '등록자']
  created_at    timestamp    [not null, note: '등록일시']
}

Table MILEAGE_POLICY [note: '프로그램별 마일리지 적립 기준'] {
  policy_id        int         [pk, increment, note: '정책ID']
  program_id       int         [not null, ref: > PROGRAM.program_id, note: '프로그램ID']
  participate_type varchar(20) [not null, note: '참여구분 (참여/입상)']
  points           int         [not null, note: '부여 포인트']
  description      varchar(500) [note: '설명']
  is_use           varchar(1)  [default: 'Y', note: '사용여부 Y/N']
}

Table MILEAGE_APPLY [note: '마일리지 적립 신청 및 승인 상태'] {
  apply_id         bigint      [pk, increment, note: '신청ID']
  student_id       int         [not null, ref: > STUDENT.student_id, note: '학생ID']
  policy_id        int         [not null, ref: > MILEAGE_POLICY.policy_id, note: '정책ID']
  apply_points     int         [not null, note: '신청 포인트']
  confirmed_points int         [note: '확정 포인트 (승인 시 결정)']
  status           varchar(20) [default: '대기', note: '상태 (대기/승인/반려/취소/회수)']
  approver_id      int         [ref: > USER.user_id, note: '승인자']
  apply_dt         timestamp   [not null, note: '신청일시']
  approve_dt       timestamp   [note: '처리일시']
  process_comment  varchar(500) [note: '처리의견']
}

Table ATTACH_FILE [note: '마일리지 신청 증빙 첨부파일'] {
  file_id     bigint      [pk, increment, note: '첨부파일ID']
  apply_id    bigint      [not null, ref: > MILEAGE_APPLY.apply_id, note: '신청ID']
  file_name   varchar(255) [not null, note: '원본 파일명']
  file_path   varchar(500) [not null, note: '서버 저장 경로']
  file_size   bigint      [note: '파일 크기 (bytes)']
  uploaded_by int         [ref: > USER.user_id, note: '등록자']
  upload_dt   timestamp   [not null, note: '등록일시']
}

Table MILEAGE_LEDGER [note: '실제 적립·회수 거래 원장'] {
  ledger_id  bigint      [pk, increment, note: '원장ID']
  student_id int         [not null, ref: > STUDENT.student_id, note: '학생ID']
  apply_id   bigint      [not null, ref: > MILEAGE_APPLY.apply_id, note: '신청ID']
  trans_type varchar(10) [not null, note: '거래구분 (적립/회수)']
  points     int         [not null, note: '포인트 (+적립 / -회수)']
  trans_dt   timestamp   [not null, note: '거래일시']
  created_by int         [ref: > USER.user_id, note: '처리자']
  reason     varchar(500) [note: '사유']
}


// ─────────────────────────────────────
//  05 예산·지출
// ─────────────────────────────────────

Table BUDGET_PROJECT [note: '예산사업 단위'] {
  project_id    int          [pk, increment, note: '사업ID']
  fiscal_year   int          [not null, note: '사업연도']
  project_round int          [not null, note: '사업차수']
  project_name  varchar(200) [not null, note: '사업명']
  start_date    date         [note: '시작일자']
  end_date      date         [note: '종료일자']
  status        varchar(20)  [default: '준비', note: '상태']
}

Table BUDGET_ITEM [note: '7개 예산항목 기준정보'] {
  item_id    int         [pk, increment, note: '예산항목ID']
  item_code  varchar(20) [unique, not null, note: '항목코드']
  item_name  varchar(50) [not null, note: '항목명 (인건비/학생인건비 등 7종)']
  sort_order int         [note: '정렬순서']
  is_use     varchar(1)  [default: 'Y', note: '사용여부 Y/N']
}

Table PROJECT_BUDGET [note: '사업×항목별 예산한도 (UNIQUE: project+item)'] {
  project_budget_id bigint     [pk, increment, note: '사업예산ID']
  project_id        int        [not null, ref: > BUDGET_PROJECT.project_id, note: '사업ID']
  item_id           int        [not null, ref: > BUDGET_ITEM.item_id, note: '예산항목ID']
  allocated_amount  bigint     [not null, note: '최초예산금액']
  expense_limit     bigint     [not null, note: '지출한도']
  status            varchar(20) [default: '초안', note: '상태 (초안/확정)']
  created_by        int        [ref: > USER.user_id, note: '입력자']
  created_at        timestamp  [not null, note: '입력일시']
  confirmed_by      int        [ref: > USER.user_id, note: '확정자']
  confirmed_at      timestamp  [note: '확정일시']

  indexes {
    (project_id, item_id) [unique, name: 'uq_project_budget']
  }
}

Table PROFESSOR [note: '지출 책임 교수 기준정보'] {
  professor_id int         [pk, increment, note: '교수ID']
  prof_no      varchar(20) [unique, not null, note: '교번']
  prof_name    varchar(50) [not null, note: '성명']
  dept_id      int         [ref: > DEPARTMENT.dept_id, note: '학과ID']
  is_active    varchar(1)  [default: 'Y', note: '사용여부 Y/N']
}

Table EXPENSE [note: '개별 지출내역 및 승인 상태'] {
  expense_id        bigint      [pk, increment, note: '지출ID']
  project_budget_id bigint      [not null, ref: > PROJECT_BUDGET.project_budget_id, note: '사업예산ID']
  professor_id      int         [ref: > PROFESSOR.professor_id, note: '지출교수ID']
  expense_entity    varchar(20) [note: '지출주체구분 (산학협력/전공/융합)']
  expense_date      date        [not null, note: '지출일자']
  amount            bigint      [not null, note: '지출금액 (양수)']
  description       varchar(500) [note: '적요']
  status            varchar(20) [default: '대기', note: '승인상태 (대기/승인/반려/취소)']
  created_by        int         [ref: > USER.user_id, note: '등록자']
  created_at        timestamp   [not null, note: '등록일시']
  approver_id       int         [ref: > USER.user_id, note: '승인자']
  approve_dt        timestamp   [note: '승인일시']
  process_comment   varchar(500) [note: '처리의견']
}

Table STUDENT_STIPEND [note: '학생인건비 학생별·월별 지급 상세'] {
  stipend_id    bigint     [pk, increment, note: '지급ID']
  expense_id    bigint     [not null, ref: > EXPENSE.expense_id, note: '지출ID (학생인건비만)']
  student_id    int        [not null, ref: > STUDENT.student_id, note: '학생ID']
  payment_month varchar(6) [not null, note: '지급연월 YYYYMM']
  amount        bigint     [not null, note: '지급액']
  tax_deducted  bigint     [default: 0, note: '공제세액']
  status        varchar(20) [default: '대기', note: '지급상태']
}

Table BUDGET_CHANGE_HIST [note: '예산액·지출한도 변경 이력'] {
  budget_hist_id    bigint      [pk, increment, note: '예산변경이력ID']
  project_budget_id bigint      [not null, ref: > PROJECT_BUDGET.project_budget_id, note: '사업예산ID']
  change_type       varchar(20) [not null, note: '변경구분 (예산액/지출한도)']
  before_amount     bigint      [note: '변경전금액']
  after_amount      bigint      [note: '변경후금액']
  change_reason     varchar(500) [note: '변경사유']
  changed_by        int         [ref: > USER.user_id, note: '변경자']
  changed_at        timestamp   [not null, note: '변경일시']
}


// ─────────────────────────────────────
//  06 만족도
// ─────────────────────────────────────

Table SURVEY [note: '프로그램별 만족도 조사'] {
  survey_id    int          [pk, increment, note: '조사ID']
  program_id   int          [not null, ref: > PROGRAM.program_id, note: '프로그램ID']
  title        varchar(200) [not null, note: '조사명']
  start_date   date         [not null, note: '시작일']
  end_date     date         [not null, note: '종료일']
  status       varchar(20)  [default: '초안', note: '상태 (초안/공개/마감)']
  dup_allow_yn varchar(1)   [default: 'N', note: '중복응답허용 Y/N']
  created_by   int          [ref: > USER.user_id, note: '등록자']
}

Table SURVEY_QUESTION [note: '조사별 설문 문항'] {
  question_id   bigint      [pk, increment, note: '문항ID']
  survey_id     int         [not null, ref: > SURVEY.survey_id, note: '조사ID']
  question_no   int         [not null, note: '문항번호 (정렬 기준)']
  question_text varchar(500) [not null, note: '문항내용']
  question_type varchar(20) [not null, note: '문항유형 (리커트/주관식)']
  scale_min     int         [note: '척도최소값 (예: 1)']
  scale_max     int         [note: '척도최대값 (예: 5)']
  required_yn   varchar(1)  [default: 'Y', note: '필수응답여부 Y/N']
}

Table SURVEY_RESPONSE [note: '학생 조사 참여·완료 여부 (UNIQUE: survey+student)'] {
  response_id  bigint    [pk, increment, note: '응답ID']
  survey_id    int       [not null, ref: > SURVEY.survey_id, note: '조사ID']
  student_id   int       [not null, ref: > STUDENT.student_id, note: '학생ID']
  submitted_at timestamp [note: '응답 시작일시']
  is_complete  varchar(1) [default: 'N', note: '완료여부 Y/N']
  completed_at timestamp [note: '완료일시']

  indexes {
    (survey_id, student_id) [unique, name: 'uq_survey_response']
  }
}

Table SURVEY_ANSWER [note: '문항별 점수·주관식 답변 (UNIQUE: response+question)'] {
  answer_id          bigint       [pk, increment, note: '답변ID']
  response_id        bigint       [not null, ref: > SURVEY_RESPONSE.response_id, note: '응답ID']
  question_id        bigint       [not null, ref: > SURVEY_QUESTION.question_id, note: '문항ID']
  score              int          [note: '점수 (척도 범위 내)']
  subjective_opinion varchar(1000) [note: '주관식 의견']

  indexes {
    (response_id, question_id) [unique, name: 'uq_survey_answer']
  }
}
